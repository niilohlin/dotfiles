font-family = "JetBrainsMonoNL Nerd Font"
font-family-bold = "JetBrainsMonoNL Nerd Font Bold"
font-family-italic = "JetBrainsMonoNL Nerd Font Italic"
font-family-bold-italic = "JetBrainsMonoNL Nerd Font Bold Italic"
font-size = 18

font-feature=-calt
font-feature=-liga
font-feature=-dlig

theme = Gruvbox Dark

keybind = cmd+t=unbind
keybind = cmd+enter=unbind
keybind = ctrl+o=unbind

# herdr has no way to bind one key to a sequence of its own actions, so this
# types ctrl+b g / into it: open the session navigator, then start filtering.
keybind = ctrl+b>y=text:\x02g/

mouse-hide-while-typing = true

# keybind = cmd+c=text:\x03

